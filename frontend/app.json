{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.headlampslots.fhvtsl",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pošalji tačnu adresu za dolazak na lokaciju",
        "NSCameraUsageDescription": "Snimi novu fotku farova za galeriju",
        "NSPhotoLibraryUsageDescription": "Otpremi sliku farova iz galerije"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.headlampslots.fhvtsl",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FF9800"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dozvoli pristup galeriji da bi otpremio slike farova",
          "cameraPermission": "Dozvoli pristup kameri da bi snimio novu fotku farova"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pošalji tačnu adresu za dolazak na lokaciju"
        }
      ],
      "expo-sharing",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
